{
  "name": "neuro-engine",
  "projectType": "application",
  "sourceRoot": "services/neuro-engine/src",
  "implicitDependencies": ["@neuro-observatory/protocol"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "services/neuro-engine",
        "command": "uv run uvicorn neuro_engine.main:app --reload --host 127.0.0.1 --port 8000"
      },
      "cache": false
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "{workspaceRoot}/packages/protocol/schemas/**/*",
        "{workspaceRoot}/packages/protocol/fixtures/**/*"
      ],
      "options": {
        "cwd": "services/neuro-engine",
        "command": "uv run pytest"
      }
    },
    "test-integration": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "services/neuro-engine",
        "command": "uv run --extra neuroimaging pytest -m integration tests/integration"
      },
      "cache": false
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "services/neuro-engine",
        "command": "uv run ruff check ."
      }
    }
  }
}
